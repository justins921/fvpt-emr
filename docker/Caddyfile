# Caddy reverse proxy for FVPT-EMR on-site deployment.
#
# DOMAIN controls which hostname Caddy serves and how TLS is handled:
#   - Public domain (e.g. emr.yourclinic.com):
#       DOMAIN=emr.yourclinic.com  ->  automatic HTTPS via Let's Encrypt
#   - LAN-only hostname or IP (e.g. emr.local, 192.168.1.50):
#       DOMAIN=emr.local            ->  self-signed TLS (tls internal)
#       Set TLS_MODE=internal explicitly if Caddy can't tell.
#
# Set these in your .env file before running docker compose up.

{
    # Cookie and Authorization headers are stripped from access logs
    # to avoid writing session tokens to disk.
}

{$DOMAIN:emr.local} {
    {$TLS_MODE:tls internal}

    # API proxy
    handle /api/* {
        reverse_proxy server:3001
    }

    # Client app
    handle {
        reverse_proxy client:8080
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    log {
        output file /var/log/caddy/access.log
        format filter {
            wrap console
            fields {
                request>headers>Cookie delete
                request>headers>Authorization delete
            }
        }
    }
}
