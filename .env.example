NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://emr:emr_dev_password@localhost:5432/fvpt_emr

# JWT (CHANGE IN PRODUCTION - minimum 32 characters)
JWT_SECRET=dev-only-secret-change-me-in-production-minimum-32-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Session
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Network
ALLOWED_ORIGINS=https://emr.local,http://localhost:5173
IP_ALLOWLIST=
TRUST_PROXY=false

# Logging
LOG_LEVEL=info

# ── Vercel Deployment ──
# When deploying to Vercel, set these in the Vercel dashboard:
#   DATABASE_URL    → Your Vercel Postgres / Neon connection string
#   POSTGRES_URL    → (auto-set if using Vercel Postgres integration)
#   JWT_SECRET      → openssl rand -hex 64
#   ALLOWED_ORIGINS → https://your-project.vercel.app
