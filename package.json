{
  "name": "fvpt-emr",
  "version": "0.1.0",
  "private": true,
  "description": "Physical Therapy EMR - Vercel + local-first on-premises",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "test": "cd server && npm test",
    "test:integration": "cd server && npm run test:integration",
    "migrate": "cd server && npm run migrate",
    "migrate:down": "cd server && npm run migrate:down",
    "seed": "cd server && npm run seed",
    "lint": "cd server && npm run lint && cd ../client && npm run lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
