{
  "name": "emr-os",
  "version": "0.1.0",
  "private": true,
  "description": "EMR OS by Sobojinski Solutions",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "test": "npm test -w server",
    "test:integration": "npm run test:integration -w server",
    "migrate": "npm run migrate -w server",
    "migrate:down": "npm run migrate:down -w server",
    "seed": "npm run seed -w server",
    "lint": "npm run lint -w server && npm run lint -w client",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
